{
  "expo": {
    "name": "claude-usage-mobile",
    "slug": "claude-usage-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "claudeusagemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Claude Usage connects to the companion app running on your Mac over your local network to read your usage.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.mindzone.tech.claudeusage.ios"
    },
    "android": {
      "package": "com.mindzone.tech.claudeusage.android",
      "adaptiveIcon": {
        "backgroundColor": "#1A1613",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon-tinted.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-blank-splash",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Claude Usage uses the camera to scan the pairing QR code shown on your Mac."
        }
      ],
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.mindzone.tech.claudeusage.ios.widgets",
          "groupIdentifier": "group.com.mindzone.tech.claudeusage",
          "widgets": [
            {
              "name": "SessionWidget",
              "displayName": "Claude Usage",
              "description": "Your current Claude session and weekly usage.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false
            },
            {
              "name": "SessionActivity",
              "displayName": "Claude Session",
              "description": "Live activity for your active Claude session.",
              "supportedFamilies": [
                "systemMedium"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ],
      "expo-image",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "expo-background-task",
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
